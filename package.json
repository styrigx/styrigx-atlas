{
  "name": "styrigx-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "图志：博客、奇趣、日刻（atlas.styrigx.com/blog/、/curio/、/daymark/）。Hugo + Tailwind 4，和主站 styrigx-space 同栈。",
  "author": "Sloan Gray",
  "homepage": "https://atlas.styrigx.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/styrigx/styrigx-atlas.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "sites/blog",
    "sites/curio",
    "sites/daymark"
  ],
  "scripts": {
    "build": "npm run build -ws && node scripts/assemble.mjs",
    "assemble": "node scripts/assemble.mjs",
    "test": "node --test tests/*.test.mjs && npm test -ws",
    "test:e2e": "npm run test:e2e -ws",
    "shell:check": "npm run shell:check -ws"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
