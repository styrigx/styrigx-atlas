{"description":"图志根首页（atlas.styrigx.com/）：Hugo + Tailwind 4 页面，与奇趣、日刻同一套 Styrigx UI 外壳。依赖在仓库根 package.json。","name":"atlas-root","private":true,"scripts":{"build":"npm run build:css && hugo --minify --cleanDestinationDir -s web","build:css":"tailwindcss -i web/assets/css/input.css -o web/assets/css/main.css --minify","shell:check":"node scripts/sync-shell.mjs --check","shell:sync":"node scripts/sync-shell.mjs","test":"node --test tests/web/*.test.mjs","test:e2e":"playwright test --config=tests/config/playwright.e2e.config.js"},"version":"1.0.0"}